      "家里",
      "旅途",
      "等待",
      "睡前"
    ],
    "types": [
      "动手",
      "安静"
    ],
    "age": "5岁+",
    "people": "2人",
    "time": "5-15分钟",
    "materials": [
      "一根约1米长的毛线绳，两端打结成圈"
    ],
    "rules": [
      "把绳圈套在双手手指上撑开，做出初始花样。",
      "另一人用手指挑、勾、穿，变出新花样，如面条、桥、星星。",
      "轮流接手，每人变一个花样再交给对方，谁翻错谁重来。",
      "可以一起研究新花样，比谁会的花样多。"
    ],
    "tips": "先教两三个简单花样，孩子学会后会很得意，再慢慢加难度。",
    "source": "民间传统游戏",
    "license": "原创改写"
  },
  {
    "id": "game_outdoor_002",
    "type": "game",
