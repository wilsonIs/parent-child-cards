[
  {
    "id": "game_home_001",
    "type": "game",
    "title": "123木头人",
    "icon": "🪵",
    "scenes": [
      "家里",
      "户外",
      "雨天/室内"
    ],
    "types": [
      "放电",
      "多人",
      "无需材料"
    ],
    "age": "3岁+",
    "people": "2人以上",
    "time": "5-15分钟",
    "materials": [],
    "rules": [
      "选一人当木头人，背对大家站好，其余人站在起跑线。",
      "木头人大声喊一二三木头人，其他人趁机悄悄向前跑。",
      "喊完立刻回头，谁还在动就退回起点或出局。",
      "有人拍到木头人，大家往回跑，木头人转身追拍，被拍到的下一轮当木头。"
    ],
    "tips": "孩子小就把动的标准放宽，衣服飘动也算没动，多给几次机会。",
    "source": "民间传统游戏",
    "license": "原创改写"
  },
  {
    "id": "game_home_002",
    "type": "game",
    "title": "丢手绢",
    "icon": "🧣",
    "scenes": [
      "家里",
      "户外",
      "聚会"
    ],
    "types": [
      "多人",
      "放电",
      "无需材料"
    ],
    "age": "3岁+",
    "people": "3人以上",
    "time": "5-15分钟",
    "materials": [
      "一块手绢或小毛巾"
    ],
    "rules": [
      "大家围成圆圈坐下，一人拿手绢在圈外慢慢走。",
      "悄悄把手绢丢在某人身后再绕一圈，被发现后两人你追我跑。",
      "跑得慢的或没发现被丢的，下一轮来丢手绢。",
      "可以边玩边唱丢手绢的歌，气氛更热闹。"
    ],
    "tips": "丢的位置让孩子自己挑，提醒别总丢给同一个人。",
    "source": "民间传统游戏",
    "license": "原创改写"
  },
  {
    "id": "game_outdoor_001",
    "type": "game",
    "title": "跳房子",
    "icon": "🦶",
    "scenes": [
      "户外",
      "雨天/室内"
    ],
    "types": [
      "放电",
      "动手"
    ],
    "age": "4岁+",
    "people": "1-4人",
    "time": "10-20分钟",
    "materials": [
      "粉笔",
      "小石头或沙包"
    ],
    "rules": [
      "用粉笔在地上画1到9格房子，格子里写数字。",
      "把沙包扔到第1格，单脚跳过它到下一格，依次跳完全部。",
      "回程捡起沙包，途中不能踩线、不能双脚落地（并排两格可双脚）。",
      "谁先跳完全部格子并把沙包扔回起点，谁就赢。"
    ],
    "tips": "孩子小可以少画几格、允许双脚落地，重点是玩得开心。",
    "source": "民间传统游戏",
    "license": "原创改写"
  },
  {
    "id": "game_home_003",
    "type": "game",
    "title": "翻花绳",
    "icon": "🧶",
