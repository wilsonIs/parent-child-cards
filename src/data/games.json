      "聚会"
    ],
    "types": [
      "放电",
      "多人",
      "无需材料"
    ],
    "age": "4岁+",
    "people": "3人以上",
    "time": "5-15分钟",
    "materials": [],
    "rules": [
      "一人当老鹰，一人当母鸡，其余人排成一列抓住前一人衣服当小鸡。",
      "老鹰想办法绕过母鸡去拍队尾的小鸡，母鸡张开双臂左右挡。",
      "小鸡要跟着母鸡跑动，队伍断了或被拍到就出局。",
      "抓完所有小鸡，或限定时间内没抓到，老鹰换人当。"
    ],
    "tips": "人多场地小就少排几只小鸡，注意别撞到桌椅和墙角。",
    "source": "民间传统游戏",
    "license": "原创改写"
  },
